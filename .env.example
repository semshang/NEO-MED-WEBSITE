# ==============================================================================
# NEO-MED-WEBSITE Environment Configuration Template (.env.example)
#
# IMPORTANT:
# - Set these values in your deployment provider (Vercel) and local .env.local.
# - NEVER commit real credentials, secrets, or .env.local to version control.
# - URLs below are production examples only, not confirmation of Vercel settings.
# ==============================================================================

# Database (Required, Server-only)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=

# Authentication (Required, Server-only)
# High-entropy 32+ character secret for signing session JWT tokens (e.g. openssl rand -base64 32)
NEXTAUTH_SECRET=

# Public Canonical URL (Required for NextAuth, Server-only)
# Canonical production example (in preview environments, use the preview deployment URL):
NEXTAUTH_URL=https://neomeditech.com.np

# Public Site URL (Optional, Client & Server)
# Used for canonical metadata, OpenGraph, sitemap, and robots.txt. Defaults to https://neomeditech.com.np
NEXT_PUBLIC_SITE_URL=https://neomeditech.com.np

# Google OAuth 2.0 (Required for Admin Google sign-in, Server-only)
# Configured in Google Cloud Console with exact authorized redirect URI (${NEXTAUTH_URL}/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Administrator Access (Required for admin role authorization, Server-only)
# Comma-separated list of Google account email addresses authorized for administrator access.
# Example: neomeditech.solutions@gmail.com
ADMIN_EMAILS=

# Transactional Email (Required for complete production email functionality, Server-only)
# Optional to compile/boot, but required for contact form forwarding, email verification, and password resets.
# Resend API key (format: re_xxxxxxxxxxxx)
RESEND_API_KEY=

# Verified Sender Address (Required for complete production email functionality, Server-only)
# Must be an address on a verified domain in Resend (e.g. support@neomeditech.com.np).
# NOTE: This is the outgoing sender address, NOT the private business destination inbox (contact.neomeditech@gmail.com).
RESEND_FROM_EMAIL=support@neomeditech.com.np

# Vercel Blob Storage (Required for product image uploads on Vercel, Server-only)
# Auto-provisioned when linking a Vercel Blob Store to the project in Vercel Dashboard.
# Format: vercel_blob_rw_xxxxxxxxxxxxxxxx_xxxxxxxxxxxxxxxx
BLOB_READ_WRITE_TOKEN=
